# Copy this file to .env and fill in the values. Leave blank to run without them.

# --- Shopify (products, stock, orders, checkout) ---
# Your store's myshopify domain, e.g. shreem-lifestyle.myshopify.com
VITE_SHOPIFY_STORE_DOMAIN=
# Storefront API public access token (Shopify admin > Sales channels > Headless)
VITE_SHOPIFY_STOREFRONT_TOKEN=
# Optional: Storefront API version
VITE_SHOPIFY_API_VERSION=2026-07

# --- Formspree (contact form + newsletter delivered to your email) ---
# The form ID from https://formspree.io, e.g. xyzabcde
VITE_FORMSPREE_ID=
