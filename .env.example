# Copy this file to .env and fill in the values (Vercel: Project Settings > Environment Variables).

# --- Supabase (Project Settings > API) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
# Public "anon" key - safe in the browser
VITE_SUPABASE_ANON_KEY=
# SECRET "service_role" key - server only, never share it
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (Dashboard > Account & Settings > API Keys) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
# Secret you choose when adding the webhook (Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# --- Order emails via Resend (optional, https://resend.com) ---
RESEND_API_KEY=
# e.g. Shreem Lifestyle <orders@shreemlifestyle.com>  (domain verified in Resend)
ORDER_EMAIL_FROM=
# Where new-order notifications go
ORDER_NOTIFY_EMAIL=

# --- Contact form + newsletter via Formspree (optional) ---
VITE_FORMSPREE_ID=
